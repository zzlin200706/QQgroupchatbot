APP_ENV=development
LOG_LEVEL=INFO

QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_API_TIMEOUT_SECONDS=10
QQ_GATEWAY_RECONNECT_INITIAL_DELAY_SECONDS=1
QQ_GATEWAY_RECONNECT_MAX_DELAY_SECONDS=30

DATABASE_URL=sqlite+aiosqlite:///./data/qqgroupchatbot.db

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=4096

SUMMARY_MAX_MESSAGES=500
SUMMARY_MAX_INPUT_CHARS=120000
SUMMARY_COMMAND_ENABLED=false
SUMMARY_COMMAND_LOOKBACK_MINUTES=120
SUMMARY_COMMAND_COOLDOWN_SECONDS=60

FORWARD_MAX_DEPTH=10
FORWARD_MAX_NODES=500
MESSAGE_MAX_SEGMENTS=1000

API_HOST=127.0.0.1
API_PORT=8000
