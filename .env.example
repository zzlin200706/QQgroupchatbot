APP_ENV=development
LOG_LEVEL=INFO
LLM_PROVIDER=openai_compatible
LLM_MAX_OUTPUT_TOKENS=4096

QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_EVENT_TRANSPORT=websocket
QQ_API_TIMEOUT_SECONDS=10
QQ_GATEWAY_RECONNECT_INITIAL_DELAY_SECONDS=1
QQ_GATEWAY_RECONNECT_MAX_DELAY_SECONDS=30
QQ_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=5

DATABASE_URL=sqlite+aiosqlite:///./data/qqgroupchatbot.db
LLM_MAX_CONCURRENT_INTERACTIONS=4
INTERACTION_OUTBOX_RETENTION_DAYS=7
# Raw events are retained permanently; no automatic raw-event cleanup.

OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# Required when SUMMARY_COMMAND_ENABLED or GROUP_ASSISTANT_ENABLED is true
# and LLM_PROVIDER=openai_compatible.  Must be the model your relay serves.
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
OPENAI_COMPATIBLE_MAX_RETRIES=2

VISION_ENABLED=false
VISION_PROVIDER=openai_compatible
VISION_MODEL=
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
IMAGE_MAX_BYTES=10485760

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Required when SUMMARY_COMMAND_ENABLED or GROUP_ASSISTANT_ENABLED is true
# and LLM_PROVIDER=deepseek.
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

SUMMARY_MAX_MESSAGES=500
# Maximum characters in each summary user prompt, including metadata.
# Long windows are split at message boundaries; fixed system prompt is extra.
SUMMARY_MAX_INPUT_CHARS=120000
SUMMARY_COMMAND_ENABLED=false
SUMMARY_COMMAND_LOOKBACK_MINUTES=120
SUMMARY_COMMAND_COOLDOWN_SECONDS=60

GROUP_ASSISTANT_ENABLED=true
QA_LOOKBACK_MINUTES=120
QA_MAX_MESSAGES=150
CHAT_LOOKBACK_MINUTES=30
CHAT_MAX_MESSAGES=80
CHAT_MAX_ASSISTANT_TURNS=20
ASSISTANT_MAX_INPUT_CHARS=40000
ASSISTANT_MAX_OUTPUT_TOKENS=1200
ASSISTANT_MAX_OUTPUT_CHARS=4500
ASSISTANT_COOLDOWN_SECONDS=3

FORWARD_MAX_DEPTH=10
FORWARD_MAX_NODES=500
MESSAGE_MAX_SEGMENTS=1000

API_HOST=127.0.0.1
API_PORT=8000
